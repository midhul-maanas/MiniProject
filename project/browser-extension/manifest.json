{
  "manifest_version": 3,
  "name": "Digital Carbon Footprint Tracker",
  "version": "1.0.0",
  "description": "Track your digital carbon footprint from browser activities",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}